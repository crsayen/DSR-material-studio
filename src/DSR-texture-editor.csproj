<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The desktop app: a WebView2 window over an in-process ASP.NET Core server (loopback only, random
    port). The page (wwwroot) is embedded in the exe; when run from this source tree it is served
    from the folder instead, so edits only need a reload (F5).

      dotnet run                        the window
      dotnet run (two dashes) serve     no window: http://localhost:5199/ for a normal browser
      scripts\publish.ps1               one self-contained exe in dist\
  -->
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DSR-texture-editor</AssemblyName>
    <RootNamespace>TextureEditor</RootNamespace>
    <Product>DSR Texture Editor</Product>
    <Version>0.1.0</Version>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- publish: one exe, no .NET install needed -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\lib\SoulsFormats\SoulsFormats.csproj" />
    <PackageReference Include="BCnEncoder.Net" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="6.0.36" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- The page travels inside the exe, not beside it. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>
</Project>
